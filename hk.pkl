amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    fix = true
    stash = true
    steps {
      ["lint"] {
        check = "mise :lint {{ files }}"
        fix = "mise :lint --write {{ files }}"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["issue-id"] {
        check = "plx requirements --commit-msg {{commit_msg_file}}"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["check"] {
        check = "mise :check"
      }
    }
  }
}
